<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===================================================================
         FrankMpesa component and text styles (used by themes.xml and layouts)
         =================================================================== -->

    <!-- Text fields: outlined, rounded, grey outline that turns brand green on focus -->
    <style name="Widget.FrankMpesa.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <!-- Compact text fields for record editors -->
    <style name="Widget.FrankMpesa.TextInputLayout.Dense" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
    </style>

    <!-- Cards: white on the grey background, thin outline, soft corners -->
    <style name="Widget.FrankMpesa.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
    </style>

    <!-- Buttons: no shouting capitals, comfortable height -->
    <style name="Widget.FrankMpesa.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAppearance">@style/TextAppearance.FrankMpesa.Button</item>
    </style>

    <style name="Widget.FrankMpesa.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAppearance">@style/TextAppearance.FrankMpesa.Button</item>
    </style>

    <style name="Widget.FrankMpesa.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Soft green button for secondary actions such as Edit -->
    <style name="Widget.FrankMpesa.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">?attr/colorPrimaryContainer</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
    </style>

    <!-- Destructive actions (delete, clear data) -->
    <style name="Widget.FrankMpesa.Button.Danger" parent="Widget.FrankMpesa.Button">
        <item name="backgroundTint">?attr/colorError</item>
        <item name="android:textColor">?attr/colorOnError</item>
    </style>

    <!-- Tabs: sentence case, brand-green indicator -->
    <style name="Widget.FrankMpesa.Tabs" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorColor">?attr/colorPrimary</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabSelectedTextColor">?attr/colorPrimary</item>
        <item name="tabTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="tabTextAppearance">@style/TextAppearance.FrankMpesa.Tab</item>
        <item name="tabRippleColor">?attr/colorPrimaryContainer</item>
    </style>

    <!-- Side menu: green highlight on the current screen -->
    <style name="Widget.FrankMpesa.NavigationView" parent="Widget.Material3.NavigationView">
        <item name="itemShapeFillColor">@color/nav_item_fill</item>
        <item name="itemIconTint">@color/nav_item_content</item>
        <item name="itemTextColor">@color/nav_item_content</item>
        <item name="itemTextAppearance">@style/TextAppearance.Material3.LabelLarge</item>
        <item name="subheaderColor">?attr/colorPrimary</item>
        <item name="subheaderTextAppearance">@style/TextAppearance.FrankMpesa.SectionHeader</item>
    </style>

    <style name="Widget.FrankMpesa.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="tint">?attr/colorOnPrimary</item>
    </style>

    <!-- Bottom action bar buttons on the shop screens -->
    <style name="Widget.FrankMpesa.BottomAction" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <!-- Text -->
    <style name="TextAppearance.FrankMpesa.ScreenTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.FrankMpesa.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.FrankMpesa.SectionHeader" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.FrankMpesa.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.FrankMpesa.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Money and rates: digits line up in columns -->
    <style name="TextAppearance.FrankMpesa.Amount" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="TextAppearance.FrankMpesa.TableHeader" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.FrankMpesa.TableCell" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="TextAppearance.FrankMpesa.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.FrankMpesa.Tab" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.FrankMpesa.ActionLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

</resources>
