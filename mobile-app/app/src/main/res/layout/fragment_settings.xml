<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="?attr/background_when_in_Primarycolor"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:id="@+id/settings_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5"
            android:textColor="?attr/Primarycolor"
            android:textStyle="bold"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/settings_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Customize app behavior and clear local data"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            android:textColor="@color/gray_600"
            android:paddingBottom="16dp"/>

        <!-- Theme card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="12dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/Settingtext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Appearance"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                    android:textStyle="bold"
                    android:textColor="?attr/Primarycolor"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="8dp">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/Theme_change"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dark mode"
                        android:textColor="?attr/Primarycolor"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/theme_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Toggle to switch between light and dark themes."
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                    android:textColor="@color/gray_600"
                    android:paddingTop="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Security card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_security"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="12dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/securitysettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Security"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                    android:textStyle="bold"
                    android:textColor="?attr/Primarycolor"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="8dp">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/fingerprintsecurity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enable fingerprint"
                        android:textColor="?attr/Primarycolor"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/security_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="When enabled, the app will require biometric authentication where supported."
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                    android:textColor="@color/gray_600"
                    android:paddingTop="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Data range card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_data_range"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="12dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/databaserangechoices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Data retrieval range"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                    android:textStyle="bold"
                    android:textColor="?attr/Primarycolor"/>

                <RadioGroup
                    android:id="@+id/dataRangeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="8dp">

                    <RadioButton
                        android:id="@+id/range3days"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last 3 days" />

                    <RadioButton
                        android:id="@+id/range7days"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last 7 days" />

                    <RadioButton
                        android:id="@+id/rangeMonthly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Monthly" />

                    <RadioButton
                        android:id="@+id/rangeAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All data" />
                </RadioGroup>

                <TextView
                    android:id="@+id/data_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Choose how much historical data the app should fetch by default."
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                    android:textColor="@color/gray_600"
                    android:paddingTop="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Clear local DB + Reset Password card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_clear_db"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true"
            android:layout_margin="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Clear local data section -->
                <TextView
                    android:id="@+id/localdbclearsettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Local data"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                    android:textStyle="bold"
                    android:textColor="?attr/Primarycolor"/>

                <TextView
                    android:id="@+id/localdb_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Remove cached and locally stored records from this device. This action cannot be undone."
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                    android:textColor="@color/gray_600"
                    android:paddingTop="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clearLocalData"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Clear local data"
                    android:textAllCaps="false"
                    app:cornerRadius="8dp"
                    app:iconTint="@color/white"
                    android:backgroundTint="?attr/colorError"
                    android:textColor="@android:color/white"/>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"

                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"/>

                <!-- Reset password section -->
                <TextView
                    android:id="@+id/resetPasswordTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reset Password"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                    android:textStyle="bold"
                    android:textColor="?attr/Primarycolor"/>

                <TextView
                    android:id="@+id/resetPasswordDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Change your login password. You will use the new password next time you log in."
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                    android:textColor="@color/gray_600"
                    android:paddingTop="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetPasswordBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Reset password"
                    android:textAllCaps="false"
                    app:cornerRadius="8dp"
                    android:backgroundTint="?attr/colorPrimary"
                    android:textColor="@android:color/white"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Footer -->
        <TextView
            android:id="@+id/settings_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Changes are applied immediately. Some settings may require app restart."
            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
            android:textColor="@color/gray_600"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="24dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
