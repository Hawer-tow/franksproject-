<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
  >

    <!-- Grid of buttons -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="2"
        android:padding="16dp"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true">

        <!-- Example button + label -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_sync_server"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/avatar_circle_background"
                android:src="@drawable/sync"
                android:contentDescription="Sync changes" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sync"
                android:textSize="14sp"
                android:gravity="center"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_other_option"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/avatar_circle_background"

                android:contentDescription="Other option" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Other"
                android:textSize="14sp"
                android:gravity="center"/>
        </LinearLayout>

        <!-- Add more buttons in the same pattern -->
    </GridLayout>
</com.google.android.material.card.MaterialCardView>
