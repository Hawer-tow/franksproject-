<?xml version="1.0" encoding="utf-8"?>
<!-- New transaction: title, short explanation, list of options -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:text="Send money to a customer, or ask a customer to pay the shop"
        android:textAppearance="@style/TextAppearance.FrankMpesa.Caption" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/transaction_options_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:scrollbars="vertical" />
</LinearLayout>
