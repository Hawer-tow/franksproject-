<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?android:attr/colorBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Faint background image -->

    <!-- Main scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/rates_root_tz"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Country header -->

            <LinearLayout

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:layout_marginBottom="16dp"

                android:gravity="center_vertical"

                android:orientation="horizontal">


                <com.google.android.material.imageview.ShapeableImageView

                    android:id="@+id/flagImage_tz"

                    android:layout_width="52dp"

                    android:layout_height="52dp"

                    android:contentDescription="Tanzania"

                    android:scaleType="centerCrop"

                    android:src="@drawable/tanzania_rates"

                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.RoundedImage" />


                <LinearLayout

                    android:layout_width="0dp"

                    android:layout_height="wrap_content"

                    android:layout_marginStart="14dp"

                    android:layout_weight="1"

                    android:orientation="vertical">


                    <TextView

                        android:id="@+id/rates_header_tz"

                        android:layout_width="match_parent"

                        android:layout_height="wrap_content"

                        android:text="Tanzania rates"

                        android:textAppearance="@style/TextAppearance.FrankMpesa.ScreenTitle" />


                    <TextView

                        android:id="@+id/rates_subheader_tz"

                        android:layout_width="match_parent"

                        android:layout_height="wrap_content"

                        android:text="Set today's rate and the amount limits for each direction"

                        android:textAppearance="@style/TextAppearance.FrankMpesa.Caption" />

                </LinearLayout>

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_u2t"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/titleU2T"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Uganda → Tanzania"
                        android:textAppearance="@style/TextAppearance.FrankMpesa.CardTitle"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilU2TDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/U2TDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Date"
                            android:focusable="false"
                            android:clickable="true"
                            android:inputType="none"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilU2TRate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/U2Trate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Rate"
                            android:inputType="numberDecimal"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:weightSum="2">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilU2TMin"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/U2Tminimum"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Min amount"
                                android:inputType="numberDecimal"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilU2TMax"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/U2Tmaximum"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Max amount"
                                android:inputType="numberDecimal"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/U2Tsetbtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Save Uganda → Tanzania rate"
                        android:backgroundTint="?attr/colorPrimary"
                        android:textColor="@android:color/white"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Reverse card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_t2u"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/titleT2U"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tanzania → Uganda"
                        android:textAppearance="@style/TextAppearance.FrankMpesa.CardTitle"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilT2UDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/T2UDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Date"
                            android:focusable="false"
                            android:clickable="true"
                            android:inputType="none"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilT2URate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/T2Urate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Rate"
                            android:inputType="numberDecimal"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:weightSum="2">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilT2UMin"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/T2Umimimum"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Min amount"
                                android:inputType="numberDecimal"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilT2UMax"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/T2Umaximum"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Max amount"
                                android:inputType="numberDecimal"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/T2Usetbtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Save Tanzania → Uganda rate"
                        android:backgroundTint="?attr/colorPrimary"
                        android:textColor="@android:color/white"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/footer_note_tz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Changes are saved locally and pushed to server when available."
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/gray_600"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Top-right flag overlay -->
</FrameLayout>
