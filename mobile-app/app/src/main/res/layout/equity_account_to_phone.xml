<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/equity_card_sendmoney"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="8dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="8dp"
    app:cardUseCompatPadding="true"
    android:foreground="?attr/selectableItemBackground">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_sendmoney"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title -->
            <TextView
                android:id="@+id/title_sendmoney"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Send Money"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                android:textStyle="bold"
                android:textColor="@color/equity_transaction_main_color"
                android:gravity="center"/>

            <!-- Account Number -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAccountSend"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:boxStrokeColor="@color/equity_transactions_textinput_stroke"
                app:hintTextColor="@color/equity_transactions_textinput_stroke"
                app:boxStrokeWidth="2dp">

                <AutoCompleteTextView
                    android:id="@+id/edtAccountSend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select Account Number"
                    android:inputType="none"
                    android:padding="12dp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Telco -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTelcoSend"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:boxStrokeColor="@color/equity_transactions_textinput_stroke"
                app:hintTextColor="@color/equity_transactions_textinput_stroke"
                app:boxStrokeWidth="2dp">

                <AutoCompleteTextView
                    android:id="@+id/edtTelcoSend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Tele-communication Target"
                    android:inputType="none"
                    android:padding="12dp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Recipient Phone -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRecipientPhone"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:boxStrokeColor="@color/equity_transactions_textinput_stroke"
                app:hintTextColor="@color/equity_transactions_textinput_stroke"
                app:boxStrokeWidth="2dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtRecipientPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Recipient Phone (2547XXXXXXXX)"
                    android:inputType="phone"
                    android:padding="12dp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Amount -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAmountSend"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:boxStrokeColor="@color/equity_transactions_textinput_stroke"
                app:hintTextColor="@color/equity_transactions_textinput_stroke"
                app:boxStrokeWidth="2dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtAmountSend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Amount"
                    android:inputType="numberDecimal"
                    android:padding="12dp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Rate -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRateSend"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:boxStrokeColor="@color/equity_transactions_textinput_stroke"
                app:hintTextColor="@color/equity_transactions_textinput_stroke"
                app:boxStrokeWidth="2dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtRateSend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Rate"
                    android:inputType="numberDecimal"
                    android:padding="12dp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Helper Text -->
            <TextView
                android:id="@+id/helper_text_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="All fields required. Amount and Rate must be numeric."
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                android:layout_marginTop="12dp"
                android:textColor="@android:color/darker_gray"/>

            <!-- Send Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendMoney"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Send Money"
                android:textAllCaps="false"
                app:cornerRadius="10dp"
                android:backgroundTint="@color/dark_recycler_backgroundcolor"
                android:textColor="@android:color/white"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</com.google.android.material.card.MaterialCardView>
