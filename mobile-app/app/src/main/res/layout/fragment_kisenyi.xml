<?xml version="1.0" encoding="utf-8"?>
<!-- Kisenyi branch: section title, column headers, records list, bottom actions -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/kisenyi_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Section title (set from code: Opening & closing, Sales, Buys, Expenses) -->
    <TextView
        android:id="@+id/nav_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:text="Opening &amp; closing cash"
        android:textAppearance="@style/TextAppearance.FrankMpesa.ScreenTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/kisenyi_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:text="Tap Records below to switch tables · pull down to refresh"
        android:textAppearance="@style/TextAppearance.FrankMpesa.Caption"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nav_status" />

    <!-- Records card: column headers on top, list underneath -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/status_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/kisenyi_subtitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Column headers for the current table (replaced from code) -->
            <FrameLayout
                android:id="@+id/headerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceContainer">

                <include layout="@layout/openclose_item_header" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Pull down to reload from the server -->
                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/kisenyi_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/Gridview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingTop="4dp"
                        android:paddingBottom="88dp"
                        android:scrollbars="vertical" />
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

                <LinearLayout
                    android:id="@+id/loadingOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/colorSurface"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/loadingIndicator"
                        style="?android:attr/progressBarStyleLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminateTint="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/loadingMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Fetching data from server..."
                        android:textAppearance="@style/TextAppearance.FrankMpesa.Caption" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Add record -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/AddNewRecords"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/add_row"
        android:src="@drawable/ic_add"
        app:layout_constraintBottom_toTopOf="@id/bottom_actions"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom actions -->
    <View
        android:id="@+id/kisenyimaterialDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        app:layout_constraintBottom_toTopOf="@id/bottom_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/bottom_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout style="@style/Widget.FrankMpesa.BottomAction">

            <ImageButton
                android:id="@+id/FinalUgandacashbtn"
                android:layout_width="56dp"
                android:layout_height="40dp"
                android:background="@drawable/bottom_action_pill"
                android:contentDescription="@string/summary"
                android:scaleType="centerInside"
                android:src="@drawable/kisenyi_transactions_balance"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Summary"
                android:textAppearance="@style/TextAppearance.FrankMpesa.ActionLabel" />
        </LinearLayout>

        <LinearLayout style="@style/Widget.FrankMpesa.BottomAction">

            <ImageButton
                android:id="@+id/dataseekerbtn"
                android:layout_width="56dp"
                android:layout_height="40dp"
                android:background="@drawable/bottom_action_pill"
                android:contentDescription="@string/database"
                android:scaleType="centerInside"
                android:src="@drawable/database"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Records"
                android:textAppearance="@style/TextAppearance.FrankMpesa.ActionLabel" />
        </LinearLayout>

        <LinearLayout style="@style/Widget.FrankMpesa.BottomAction">

            <ImageButton
                android:id="@+id/placeholder_btn"
                android:layout_width="56dp"
                android:layout_height="40dp"
                android:background="@drawable/bottom_action_pill"
                android:contentDescription="@string/more"
                android:scaleType="centerInside"
                android:src="@drawable/ic_more"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="More"
                android:textAppearance="@style/TextAppearance.FrankMpesa.ActionLabel" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
