<?xml version="1.0" encoding="utf-8"?>
<!-- Town Branch: section title, records list, bottom actions (same pattern as Kisenyi) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".ui.TownBranch.TownBranchFragment">

    <!-- Section title (set from code: Withdrawals, Deposits, Commissions) -->
    <TextView
        android:id="@+id/Town_nav_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:text="Withdrawals"
        android:textAppearance="@style/TextAppearance.FrankMpesa.ScreenTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/town_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:text="Tap Edit on a record to change it · pull down to refresh"
        android:textAppearance="@style/TextAppearance.FrankMpesa.Caption"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/Town_nav_status" />

    <!-- Pull down to reload from the server -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/town_refresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@id/townmaterialDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/town_subtitle">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/TownGridview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="88dp"
            android:scrollbars="vertical" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Add record -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/TownAddNewRecords"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/add_row"
        android:src="@drawable/ic_add"
        app:layout_constraintBottom_toTopOf="@id/townmaterialDivider"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom actions -->
    <View
        android:id="@+id/townmaterialDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        app:layout_constraintBottom_toTopOf="@id/town_bottom_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/town_bottom_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout style="@style/Widget.FrankMpesa.BottomAction">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/Towndbseekerbtn"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="56dp"
                android:layout_height="40dp"
                android:contentDescription="@string/database"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:icon="@drawable/database"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="?attr/colorOnSurfaceVariant"
                app:rippleColor="?attr/colorPrimaryContainer" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Records"
                android:textAppearance="@style/TextAppearance.FrankMpesa.ActionLabel" />
        </LinearLayout>

        <LinearLayout style="@style/Widget.FrankMpesa.BottomAction">

            <ImageButton
                android:id="@+id/Towncommissionbtn"
                android:layout_width="56dp"
                android:layout_height="40dp"
                android:background="@drawable/bottom_action_pill"
                android:contentDescription="Commission"
                android:scaleType="centerInside"
                android:src="@drawable/kisenyi_transactions_balance"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Commission"
                android:textAppearance="@style/TextAppearance.FrankMpesa.ActionLabel" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
