<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/congo_rates"
        android:scaleType="centerCrop"
        android:alpha="0.18" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/rates_root_cg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rates_header_cg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exchange Rates"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingBottom="8dp"/>

            <TextView
                android:id="@+id/rates_subheader_cg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manage daily buy/sell rates and transaction limits"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                android:gravity="center"
                android:textColor="@color/gray_600"
                android:paddingBottom="16dp"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_u2c"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/titleU2C"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Uganda → Congo"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                        android:textStyle="bold"
                        android:textColor="@color/primary"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilU2CDate"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/U2CDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Date"
                            android:focusable="false"
                            android:clickable="true"
                            android:inputType="none"
                            android:padding="12dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilU2CRate"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/U2Crate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Rate"
                            android:inputType="numberDecimal"
                            android:padding="12dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:weightSum="2">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilU2CMin"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/U2Cminimum"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Min amount"
                                android:inputType="numberDecimal"
                                android:padding="12dp"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilU2CMax"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/U2Cmaximum"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Max amount"
                                android:inputType="numberDecimal"
                                android:padding="12dp"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/U2Csetbtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Set U→C"
                        android:textAllCaps="false"
                        app:cornerRadius="8dp"
                        android:backgroundTint="@color/primary"
                        android:textColor="@android:color/white"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_c2u"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/titleC2U"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Congo → Uganda"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                        android:textStyle="bold"
                        android:textColor="@color/primary"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilC2UDate"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/C2UDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Date"
                            android:focusable="false"
                            android:clickable="true"
                            android:inputType="none"
                            android:padding="12dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilC2URate"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/C2Urate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Rate"
                            android:inputType="numberDecimal"
                            android:padding="12dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:weightSum="2">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilC2UMin"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/C2Umimimum"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Min amount"
                                android:inputType="numberDecimal"
                                android:padding="12dp"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilC2UMax"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/C2Umaximum"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Max amount"
                                android:inputType="numberDecimal"
                                android:padding="12dp"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/C2Usetbtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Set C→U"
                        android:textAllCaps="false"
                        app:cornerRadius="8dp"
                        android:backgroundTint="@color/primary"
                        android:textColor="@android:color/white"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/footer_note_cg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Changes are saved locally and pushed to server when available."
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                android:textColor="@color/gray_600"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ImageView
        android:id="@+id/flagImage_cg"
        android:layout_width="56dp"
        android:layout_height="36dp"
        android:layout_margin="12dp"
        android:contentDescription="Congo"
        android:src="@drawable/congo_rates"
        android:scaleType="centerCrop"

        android:padding="2dp"
        android:elevation="8dp"
        android:layout_gravity="top|end"/>
</FrameLayout>
