<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    app:cardUseCompatPadding="true"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@android:color/darker_gray"
        android:showDividers="middle"
        android:padding="8dp">

        <!-- Telco -->
        <TextView
            android:id="@+id/tvTelcoConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Telco: Safaricom"
            android:textStyle="bold"
            android:textColor="@color/Safaricom_shade"
            android:textSize="18sp"
            android:paddingBottom="8dp"/>

        <!-- Phone -->
        <TextView
            android:id="@+id/tvPhoneConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone: 2547XXXXXXXX"
            android:textColor="@color/light_kisenyi_summary_salesColor"
            android:textSize="16sp"
            android:paddingBottom="6dp"/>

        <!-- Amount -->
        <TextView
            android:id="@+id/tvAmountConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Amount: 500"
            android:textColor="@color/equity_transaction_main_color"
            android:textSize="16sp"
            android:paddingBottom="6dp"/>

        <!-- Rate -->
        <TextView
            android:id="@+id/tvRateConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rate: 100"
            android:textColor="@color/equity_transaction_main_color"
            android:textSize="16sp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
