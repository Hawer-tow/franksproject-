<?xml version="1.0" encoding="utf-8"?>
<!-- Payment request confirmation: summary shown before the request is sent -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:divider="@drawable/list_divider"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp"
    android:showDividers="middle">

    <TextView
        android:id="@+id/tvTelcoConfirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="Telco: Safaricom"
        android:textAppearance="@style/TextAppearance.FrankMpesa.Body" />

    <TextView
        android:id="@+id/tvPhoneConfirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="Phone: 2547XXXXXXXX"
        android:textAppearance="@style/TextAppearance.FrankMpesa.Body" />

    <TextView
        android:id="@+id/tvAmountConfirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="Amount: 500"
        android:textAppearance="@style/TextAppearance.FrankMpesa.Amount"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRateConfirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="Rate: 100"
        android:textAppearance="@style/TextAppearance.FrankMpesa.Body" />
</LinearLayout>
