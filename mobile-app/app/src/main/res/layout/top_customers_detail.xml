<?xml version="1.0" encoding="utf-8"?>
<!-- Top customers: placeholder until there is ranking data to show -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:text="Customers who transact most with the shop"
        android:textAppearance="@style/TextAppearance.FrankMpesa.Caption" />

    <FrameLayout
        android:id="@+id/topcustomersframework"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/topcustomersRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:scrollbars="vertical" />

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/topcustomersEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/settings_icon_bg"
                android:importantForAccessibility="no"
                android:padding="18dp"
                android:src="@drawable/customer_logo"
                app:tint="?attr/colorOnPrimaryContainer" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="No ranking yet"
                android:textAppearance="@style/TextAppearance.FrankMpesa.CardTitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Your most active customers will be listed here once there is enough transaction history."
                android:textAppearance="@style/TextAppearance.FrankMpesa.Caption" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
