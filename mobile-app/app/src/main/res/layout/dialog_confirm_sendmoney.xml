<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    app:cardUseCompatPadding="true"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@android:color/darker_gray"
        android:showDividers="middle">

        <TextView
            android:id="@+id/tvAccountConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Account: 1450160649886"
            android:textStyle="bold"
            android:textColor="@color/equity_transaction_main_color"
            android:textSize="16sp"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/tvTelcoConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Telco: Safaricom"
            android:textColor="@color/Safaricom_shade"
            android:textSize="16sp"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/tvPhoneConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone: 2547XXXXXXXX"
            android:textColor="@android:color/black"
            android:textSize="15sp"
            android:paddingBottom="6dp"/>

        <TextView
            android:id="@+id/tvAmountConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Amount: 500"
            android:textColor="@color/equity_transaction_main_color"
            android:textSize="15sp"
            android:paddingBottom="6dp"/>

        <TextView
            android:id="@+id/tvRateConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rate: 100"
            android:textColor="@color/equity_transaction_main_color"
            android:textSize="15sp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
