<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp"
    android:layout_height="200dp"
    android:layout_margin="12dp"
    app:cardCornerRadius="30dp"
    app:cardElevation="6dp"
    app:strokeColor="@color/light_Primary_background"
    app:strokeWidth="1dp"
    android:clipChildren="true"
    android:clipToPadding="false"
    app:cardPreventCornerOverlap="true"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp">

        <!-- Circular avatar with border -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/imageAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/customer_logo"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:background="@drawable/avatar_circle_background"/>

            <!-- Optional status indicator -->
            <View
                android:id="@+id/statusIndicator"
                android:layout_width="16dp"
                android:layout_height="13dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/status_circle_online" />
        </FrameLayout>

        <!-- Username -->
        <TextView
            android:id="@+id/textUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username"
            android:textColor="@color/light_Primarycolor"
            android:textSize="16sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"/>

        <!-- Extra info -->
        <TextView
            android:id="@+id/textUserInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last login: Today"
            android:textColor="?attr/colorSecondary"
            android:textSize="12sp"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginTop="4dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
