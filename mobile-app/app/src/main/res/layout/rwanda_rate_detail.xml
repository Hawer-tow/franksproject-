<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?android:attr/colorBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Faint background image (keeps the "background feel" of a flag) -->

    <!-- Scrollable content (keeps your original IDs and layout structure) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/rates_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <!-- Country header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/flagImage"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="Rwanda"
                    android:scaleType="centerCrop"
                    android:src="@drawable/rwanda_rates"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.RoundedImage" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/rates_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Rwanda rates"
                        android:textAppearance="@style/TextAppearance.FrankMpesa.ScreenTitle" />

                    <TextView
                        android:id="@+id/rates_subheader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Set today's rate and the amount limits for each direction"
                        android:textAppearance="@style/TextAppearance.FrankMpesa.Caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- Uganda → Rwanda card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_u2r"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/titleU2R"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Uganda → Rwanda"
                        android:textAppearance="@style/TextAppearance.FrankMpesa.CardTitle"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilU2RDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/U2RDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Date"
                            android:focusable="false"
                            android:clickable="true"
                            android:inputType="none"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilU2RRate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/U2Rrate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Rate"
                            android:inputType="numberDecimal"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:weightSum="2">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilU2RMin"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/U2Rminimum"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Min amount"
                                android:inputType="numberDecimal"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilU2RMax"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/U2Rmaximum"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Max amount"
                                android:inputType="numberDecimal"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/U2Rsetbtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Save Uganda → Rwanda rate"
                        android:backgroundTint="?attr/colorPrimary"
                        android:textColor="@android:color/white"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Rwanda → Uganda card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_r2u"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/titleR2U"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Rwanda → Uganda"
                        android:textAppearance="@style/TextAppearance.FrankMpesa.CardTitle"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilR2UDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/R2UDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Date"
                            android:focusable="false"
                            android:clickable="true"
                            android:inputType="none"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilR2URate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/R2Urate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Rate"
                            android:inputType="numberDecimal"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:weightSum="2">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilR2UMin"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/R2Umimimum"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Min amount"
                                android:inputType="numberDecimal"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilR2UMax"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/R2Umaximum"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Max amount"
                                android:inputType="numberDecimal"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/R2Usetbtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Save Rwanda → Uganda rate"
                        android:backgroundTint="?attr/colorPrimary"
                        android:textColor="@android:color/white"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Small footer -->
            <TextView
                android:id="@+id/footer_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Changes are saved locally and pushed to server when available."
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/gray_600"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Top-right flag overlay (rounded white background keeps it visible) -->
</FrameLayout>
