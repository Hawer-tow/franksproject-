<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Faint background image (keeps the "background feel" of a flag) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/rwanda_rates"
        android:scaleType="centerCrop"
        android:alpha="0.18" />

    <!-- Scrollable content (keeps your original IDs and layout structure) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/rates_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <TextView
                android:id="@+id/rates_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exchange Rates"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingBottom="8dp"/>

            <TextView
                android:id="@+id/rates_subheader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manage daily buy/sell rates and transaction limits"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                android:gravity="center"
                android:textColor="@color/gray_600"
                android:paddingBottom="16dp"/>

            <!-- Uganda → Rwanda card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_u2r"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/titleU2R"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Uganda → Rwanda"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                        android:textStyle="bold"
                        android:textColor="@color/primary"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilU2RDate"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/U2RDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Date"
                            android:focusable="false"
                            android:clickable="true"
                            android:inputType="none"
                            android:padding="12dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilU2RRate"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/U2Rrate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Rate"
                            android:inputType="numberDecimal"
                            android:padding="12dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:weightSum="2">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilU2RMin"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/U2Rminimum"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Min amount"
                                android:inputType="numberDecimal"
                                android:padding="12dp"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilU2RMax"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/U2Rmaximum"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Max amount"
                                android:inputType="numberDecimal"
                                android:padding="12dp"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/U2Rsetbtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Set U→R"
                        android:textAllCaps="false"
                        app:cornerRadius="8dp"
                        android:backgroundTint="@color/primary"
                        android:textColor="@android:color/white"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Rwanda → Uganda card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_r2u"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/titleR2U"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Rwanda → Uganda"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                        android:textStyle="bold"
                        android:textColor="@color/primary"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilR2UDate"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/R2UDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Date"
                            android:focusable="false"
                            android:clickable="true"
                            android:inputType="none"
                            android:padding="12dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilR2URate"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/R2Urate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Rate"
                            android:inputType="numberDecimal"
                            android:padding="12dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:weightSum="2">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilR2UMin"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/R2Umimimum"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Min amount"
                                android:inputType="numberDecimal"
                                android:padding="12dp"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilR2UMax"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/R2Umaximum"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Max amount"
                                android:inputType="numberDecimal"
                                android:padding="12dp"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/R2Usetbtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Set R→U"
                        android:textAllCaps="false"
                        app:cornerRadius="8dp"
                        android:backgroundTint="@color/primary"
                        android:textColor="@android:color/white"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Small footer -->
            <TextView
                android:id="@+id/footer_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Changes are saved locally and pushed to server when available."
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                android:textColor="@color/gray_600"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Top-right flag overlay (rounded white background keeps it visible) -->
    <ImageView
        android:id="@+id/flagImage"
        android:layout_width="56dp"
        android:layout_height="36dp"
        android:layout_margin="12dp"
        android:contentDescription="Rwanda"
        android:src="@drawable/rwanda_rates"
        android:scaleType="centerCrop"

        android:padding="2dp"
        android:elevation="8dp"
        android:layout_gravity="top|end"/>
</FrameLayout>
