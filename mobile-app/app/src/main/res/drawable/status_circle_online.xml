<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- Solid fill color -->
    <solid android:color="@color/light_Purple_persistentcolor" />

    <!-- Optional border -->
    <stroke
        android:width="2dp"
        android:color="@android:color/white" />

    <!-- Size of the circle -->
    <size
        android:width="16dp"
        android:height="16dp" />
</shape>
