# Secrets for the Spring Boot server. Loaded by application.properties
# via spring.config.import=optional:file:.env[.properties]
# This file is gitignored - never commit it. Template: .env.example

# --- MySQL ---
KISENYI_DB_USER=root
KISENYI_DB_PASSWORD=
CUSTOMER_DB_USER=root
CUSTOMER_DB_PASSWORD=

# --- Spring Security basic user (Jenga IPN) ---
SPRING_SECURITY_USER=
SPRING_SECURITY_PASSWORD=

# --- Equity Jenga (UAT) ---
JENGA_API_KEY=
JENGA_CONSUMER_SECRET=

# --- Safaricom Daraja (sandbox) ---
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
DARAJA_INITIATOR_PASSWORD=
